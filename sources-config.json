    "scoring": {
      "keywords": {
        "high_impact": {
          "words": ["breakthrough", "cure", "eradicate", "eliminate", "first-ever", "record", "historic", "revolutionary", "game-changing"],
          "score": 3
        },
        "medium_impact": {
          "words": ["improve", "advance", "progress", "develop", "increase", "reduce", "success", "effective", "significant"],
          "score": 2
        },
        "low_impact": {
          "words": ["study", "research", "report", "analysis", "finding", "investigate", "examine"],
          "score": 1
        }
      },
      "recency_boost": {
        "hours_0_24": 2,
        "hours_24_72": 1,
        "hours_72_168": 0,
